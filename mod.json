name: Build Geode Mod

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]
  workflow_dispatch:

jobs:
  build:
    runs-on: windows-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Build Mod
        uses: geode-sdk/build-geode-mod@main
        id: build
        with:
          sdk: v4.0.0
          target: Win64

      - name: Upload Artifact
        uses: actions/upload-artifact@v4
        with:
          name: geode-mod-win
          path: ${{ steps.build.outputs.build-output }}
